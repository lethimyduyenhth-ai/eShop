@using Microsoft.AspNetCore.Components.Web

<div class="row justify-content-center mb-4">
    <div class="col-md-8 col-lg-6">
        <div class="input-group input-group-lg shadow-sm">
            <span class="input-group-text bg-white border-end-0 text-muted">
                🔍
            </span>
            <input type="text" 
                   class="form-control border-start-0 ps-0 fs-6" 
                   @bind="filter" 
                   @bind:event="oninput"
                   @onkeyup="HandleKeyUp" 
                   placeholder="Nhập tên sản phẩm hoặc thương hiệu cần tìm..." />
            <button type="button" class="btn btn-primary px-4 fw-semibold fs-6" @onclick="SearchHandle">
                Tìm kiếm
            </button>
        </div>
    </div>
</div>

@code {
    private string filter = string.Empty;

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    private async Task SearchHandle()
    {
        await OnSearch.InvokeAsync(filter);
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchHandle();
        }
    }
}
