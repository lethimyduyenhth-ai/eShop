@inherits LayoutComponentBase
@using eShop.Web.CustomerPortal.Controls
@using Microsoft.AspNetCore.Components.Authorization

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <div></div>
            <div class="d-flex align-items-center gap-3">
                <ShoppingCartCountComponent />
                <AuthorizeView>
                    <Authorized>
                        <span class="badge bg-success text-white px-3 py-2 shadow-sm">
                            👤 @context.User.Identity?.Name
                        </span>
                        <a href="/logout" class="btn btn-outline-danger btn-sm fw-semibold">Đăng xuất</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn btn-outline-primary btn-sm fw-semibold">🔑 Đăng nhập Admin</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
