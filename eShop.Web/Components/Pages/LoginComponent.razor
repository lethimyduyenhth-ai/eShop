@page "/login"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Đăng nhập Admin - eShop</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white text-center py-4 border-0">
                    <div class="mb-2" style="font-size: 2.8rem;">🔐</div>
                    <h4 class="fw-bold mb-1">Đăng Nhập Quản Trị Viên</h4>
                    <p class="text-white-50 mb-0 small">Hệ thống quản lý đơn hàng eShop Admin Portal</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post" action="/login">
                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                        
                        <div class="mb-3">
                            <label for="username" class="form-label fw-semibold text-dark">Tên đăng nhập</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">👤</span>
                                <input type="text" id="username" name="username" class="form-control border-start-0 ps-0" placeholder="Nhập tên đăng nhập" value="admin" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label fw-semibold text-dark">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">🔑</span>
                                <input type="password" id="password" name="password" class="form-control border-start-0 ps-0" placeholder="Nhập mật khẩu" value="admin123" required />
                            </div>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm py-2">
                                🚀 Đăng Nhập
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light text-center py-3 border-0">
                    <small class="text-muted">💡 Tài khoản thử nghiệm: <strong>admin</strong> | Mật khẩu: <strong>bất kỳ</strong></small>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
}
