@using eShop_coreBusiness.models

@if (this.Product != null)
{
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4 d-flex align-items-stretch">
        <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden product-card w-100">
            <div class="position-relative text-center p-3 bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                @if (!string.IsNullOrEmpty(Product.ImageLink))
                {
                    <img src="@Product.ImageLink" class="card-img-top img-fluid" alt="@Product.Name" style="max-height: 160px; object-fit: contain;" />
                }
                else
                {
                    <div class="text-muted d-flex flex-column align-items-center">
                        <span style="font-size: 2.5rem;">🛍️</span>
                        <small>Chưa có hình</small>
                    </div>
                }
                <span class="position-absolute top-0 start-0 m-2 badge bg-dark opacity-75">@Product.Brand</span>
            </div>
            
            <div class="card-body d-flex flex-column justify-content-between p-3">
                <div>
                    <h6 class="card-title fw-bold text-dark mb-2" style="min-height: 2.5rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@Product.Name">
                        @Product.Name
                    </h6>
                </div>
                
                <div class="mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted small">Giá bán:</span>
                        <span class="fs-5 fw-bold text-success">@Product.Price.ToString("c")</span>
                    </div>
                    
                    <a href="@($"/product/{Product.Id}")" class="btn btn-outline-primary w-100 fw-semibold rounded-2 shadow-sm">
                        Xem chi tiết &raquo;
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Product? Product { get; set; }
}
