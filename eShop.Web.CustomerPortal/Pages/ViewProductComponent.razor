@page "/product/{id:int}"
@rendermode InteractiveServer
@using eShop_coreBusiness.models
@using eshop_UseCases.ViewProductScreen
@inject IViewProduct viewProduct
@inject NavigationManager navigationManager
@inject IAddProductToCartUseCase addProductToCartUseCase

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/product" class="text-decoration-none">Sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(product?.Name ?? "Chi tiết")</li>
        </ol>
    </nav>

    @if (product != null)
    {
        <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4">
                    @if (!string.IsNullOrEmpty(product.ImageLink))
                    {
                        <img src="@product.ImageLink" class="img-fluid rounded" alt="@product.Name" style="max-height: 350px; object-fit: contain;" />
                    }
                    else
                    {
                        <div class="text-muted text-center py-5">
                            <span style="font-size: 4rem;">🛍️</span>
                            <p class="mt-2">Chưa có hình ảnh</p>
                        </div>
                    }
                </div>
                <div class="col-md-7 d-flex flex-column justify-content-between p-4 p-lg-5">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-secondary px-3 py-2 fs-6">Thương hiệu: @product.Brand</span>
                        </div>
                        <h2 class="fw-bold text-dark mb-3">@product.Name</h2>
                        
                        <div class="my-4 p-3 bg-light rounded-3 d-inline-block">
                            <span class="text-muted me-2 fs-6">Giá ưu đãi:</span>
                            <span class="fs-2 fw-bold text-success">@product.Price.ToString("c")</span>
                        </div>

                        <div class="mb-4">
                            <h5 class="fw-bold text-dark mb-2">Mô tả sản phẩm:</h5>
                            <p class="card-text text-secondary lh-lg">@product.Description</p>
                        </div>
                    </div>

                    <div class="pt-3 border-top d-flex flex-wrap gap-3">
                        <button class="btn btn-success btn-lg px-4 py-2 fw-semibold shadow-sm rounded-3 d-flex align-items-center gap-2" @onclick="AddToCart">
                            🛒 Thêm vào giỏ hàng
                        </button>
                        
                        <a href="/product" class="btn btn-outline-secondary btn-lg px-4 py-2 rounded-3">
                            &laquo; Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center py-4 my-4 shadow-sm">
            <h4>Không tìm thấy sản phẩm!</h4>
            <p>Sản phẩm có thể đã bị xóa hoặc đường dẫn không đúng.</p>
            <a href="/product" class="btn btn-primary mt-2">
                &laquo; Quay lại trang danh sách sản phẩm
            </a>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? product;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        product = viewProduct.Execute(Id);
    }

    private void AddToCart()
    {
        if (product != null)
        {
            addProductToCartUseCase.Execute(product.Id);
            navigationManager.NavigateTo("/cart");
        }
    }
}
