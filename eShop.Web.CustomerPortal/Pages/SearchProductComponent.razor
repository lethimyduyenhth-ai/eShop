@page "/product"
@rendermode InteractiveServer
@using eShop_coreBusiness.models
@using eshop_UseCases.SearchProductScreen
@inject ISearchProduct searchProduct

<div class="container py-3">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary mb-1">Danh Sách Sản Phẩm</h2>
        <p class="text-muted">Khám phá các sản phẩm mỹ phẩm chất lượng cao</p>
    </div>

    <SearchBarComponent OnSearch="SearchHandle"></SearchBarComponent>

    @if (products != null && products.Any())
    {
        <div class="row g-4">
            @foreach (var prod in products)
            {
                <ProductItermComponent Product="prod"></ProductItermComponent>
            }
        </div>
    }
    else if (products != null && !products.Any())
    {
        <div class="alert alert-info text-center my-5 shadow-sm py-4">
            <h5 class="alert-heading fw-bold">Không tìm thấy sản phẩm!</h5>
            <p class="mb-0">Rất tiếc, không có sản phẩm nào phù hợp với từ khóa của bạn. Vui lòng thử tìm kiếm lại với từ khóa khác.</p>
        </div>
    }
    else
    {
        <div class="text-center my-5 py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Đang tải danh sách sản phẩm...</p>
        </div>
    }
</div>

@code {
    private IEnumerable<Product>? products;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        products = searchProduct.Execute();
    }

    private void SearchHandle(string filter)
    {
        products = searchProduct.Execute(filter);
    }
}